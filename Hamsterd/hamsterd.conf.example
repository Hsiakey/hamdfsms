# Hamsterd 配置模板 — ver.0.0.8
#
# 用法：复制为 hamsterd.conf 后按需修改。
# 若 hamsterd.conf 不存在，hamsterd 启动时会自动生成一份带随机口令的模板。
# 本文件不含真实口令，可以安全入库。

# ============================================================
#  必填
# ============================================================
# 被监控目录（绝对路径，或相对于 hamsterd.exe 所在目录的相对路径）
# 目录不存在时 hamsterd 拒绝启动，避免静默扫错位置。
monitor_path: C:\path\to\watch

# ============================================================
#  监听
# ============================================================
# 默认只监听本机。改成 0.0.0.0 会暴露到局域网，
# 届时「口令 + 路径白名单」是唯一防线。
ipv4_addr: 127.0.0.1
ipv4_addr_port: 9100

# ============================================================
#  安全
# ============================================================
# 连接口令。留空则首次启动时用 CSPRNG 自动生成强口令并写回配置。
codeword:

# 所有数据命令是否都必须先认证
require_auth: on

# 是否允许回环地址免认证（仅调试用，默认 off）
allow_loopback_noauth: off

# 传输加密（PROTOCOL §8）：on = 每条连接先做口令握手，之后整条连接都是密文
# （ChaCha20-Poly1305）。默认 on；老配置里没有这一项同样按 on 处理。
# 关掉等于让链路上的口令与文件内容可以被旁听，只应在协议回归测试里显式写 off。
encrypt_transport: on

# 单次上传/下载大小上限（MB）
max_transfer_mb: 8192

# 并发连接上限
max_clients: 16

# ============================================================
#  扫描与校验
# ============================================================
rescan_date: 0,0,30
verify_interval: 4320
prune_missing: off

# ============================================================
#  局域网发现（PROTOCOL §7）
# ============================================================
# 客户端广播探测，本服务只在**对方算出的 MAC 对得上 codeword** 时才单播回应；
# 对不上就一个字节都不回（这是安全要求，不是故障）。0 = 完全禁用。
# 同机跑多个实例时，每个实例必须用不同端口。
discovery_port: 9110
# 是否回应探测。off = 端口照开但永不回应（等同对无口令者隐身）。
discovery_respond: on
# 心跳间隔（秒）：TCP 事件通道的保活节奏
heartbeat_time: 3

# ============================================================
#  日志
# ============================================================
# 级别: error | warn | info | debug
log_level: info
# 日志目录（会被自动排除在监控之外，防止事件自激）
log_dir: logs
exclude_internal: on
